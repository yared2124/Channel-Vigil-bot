# ==========================================
# Telegram Bot Configuration
# ==========================================

# Bot Token obtained from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Secret token to secure incoming webhooks (1-256 characters: [A-Za-z0-9_-])
# Sent in the 'X-Telegram-Bot-Api-Secret-Token' header by Telegram
TELEGRAM_SECRET_TOKEN="your_secure_random_secret_token_here"

# Telegram Chat ID of the Administrator to receive notifications
# Obtain via @userinfobot or @RawDataBot (e.g. 123456789)
ADMIN_CHAT_ID="your_admin_chat_id_here"

# Target Channel ID or @username being monitored (optional filter: e.g. -1001234567890 or @MyChannel)
CHANNEL_ID=""

# Public URL of your deployed application or tunnel (e.g. https://xxxx.ngrok-free.app or https://your-domain.vercel.app)
# Used by scripts/manage-webhook.ts
WEBHOOK_URL="https://your-domain.com/api/telegram/webhook"
